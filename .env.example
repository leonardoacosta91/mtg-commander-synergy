# Reddit API credentials (PRAW)
# Obtené estos valores en: https://www.reddit.com/prefs/apps
# Registrá una app de tipo "script" si no tenés una.

REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USERNAME=your_reddit_username
REDDIT_PASSWORD=your_reddit_password
# Formato requerido: script:<app_name>:<version> (by u/<username>)
REDDIT_USER_AGENT=script:mtg-commander-synergy:v1.0 (by u/your_reddit_username)

# ── LLM provider ──────────────────────────────────────────────────────────────
# Cambiar de provider (Gemini / Claude / ChatGPT) es solo editar LLM_PROVIDER
# y configurar la API key correspondiente. El modelo se puede fijar con LLM_MODEL
# (si no, se usa el default del provider).
LLM_PROVIDER=gemini
# LLM_MODEL=gemini-flash-latest

# Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic API key (https://console.anthropic.com/) — solo si usás Claude
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API key (https://platform.openai.com/api-keys) — solo si usás OpenAI
# OPENAI_API_KEY=your_openai_api_key_here
